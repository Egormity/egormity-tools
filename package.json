{
  "name": "egormity-tools",
  "version": "0.4.0",
  "scripts": {
    "cursor:anathema-pink": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -PackId anathema-pink -Apply",
    "cursor:apply": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -PackId %npm_config_pack% -Apply",
    "cursor:crystal-clear": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -PackId crystal-clear-v41 -Apply",
    "cursor:download": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/download-cursor-packs.ps1",
    "cursor:list": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -List",
    "cursor:kami": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -PackId kami -Apply",
    "cursor:marathon": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -PackId marathon -Apply",
    "cursor:marathon-bold": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -PackId marathon-bold -Apply",
    "cursor:material-dark": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -PackId material-design-cursors-dark -Apply",
    "cursor:menu": "windows_config\\cursor_packs\\open-cursor-menu.cmd",
    "cursor:monolith": "powershell -ExecutionPolicy Bypass -File windows_config/scripts/switch-cursor-pack.ps1 -PackId monolith -Apply",
    "setpath": "node scripts/setpath.js"
  }
}
