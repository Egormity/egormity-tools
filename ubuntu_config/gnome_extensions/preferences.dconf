[appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0

[dash-to-dock]
dash-max-icon-size=48
dock-fixed=true
dock-position='LEFT'
extend-height=true
multi-monitor=false

[ding]
check-x11wayland=true
icon-size='standard'
show-home=false
start-corner='top-left'

[lilypad]
auto-collapse=true
hide-indicator=2
icon-style=0
rightbox-order=['tiling_assistant', 'lilypad', 'lockkeys', 'keyboard', 'tray_icon_tray_app', 'StatusNotifierItem', 'tray_icon_tray_app_main', 'indicator_solaar', 'software_update_available', 'livepatch', 'unattended_upgrade']
show-icons=false

[lockkeys]
capslock-notification='compact'
numlock-indicator='never'
numlock-notification='compact'

[notification-timeout]
always-normal=false
ignore-idle=true
timeout=1000

[tiling-assistant]
disable-tile-groups=false
enable-tiling-popup=true
focus-hint-color='rgb(203,67,20)'
last-version-installed=54
overridden-settings={'org.gnome.mutter.edge-tiling': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-left': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-right': <@mb nothing>}

[top-bar-organizer]
center-box-order=['dateMenu']
left-box-order=['activities']
